<UserControl x:Class="HelloID.Vault.Management.Views.Administration.AdCorrelationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AD Correlation"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Correlate vault persons to Active Directory accounts via a configurable attribute and review match recommendations"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:AppBarButton Icon="Play"
                                     Label="Run Correlation"
                                     Command="{Binding RunCorrelationCommand}"/>
                    <ui:AppBarButton Icon="LightningBolt"
                                     Label="Generate Recommendations"
                                     Command="{Binding GenerateRecommendationsCommand}"
                                     ToolTip="Suggest matches for uncorrelated persons"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- Summary -->
                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,16"
                        Visibility="{Binding Summary, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Last run: "/>
                        <Run Text="{Binding Summary.TotalPersons, Mode=OneWay}"/><Run Text=" persons - "/>
                        <Run Text="{Binding Summary.Matched, Mode=OneWay}"/><Run Text=" matched, "/>
                        <Run Text="{Binding Summary.NotFound, Mode=OneWay}"/><Run Text=" not found, "/>
                        <Run Text="{Binding Summary.Ambiguous, Mode=OneWay}"/><Run Text=" ambiguous, "/>
                        <Run Text="{Binding Summary.ManuallyMatched, Mode=OneWay}"/><Run Text=" manually matched | "/>
                        <Run Text="{Binding Summary.AdAccountsTotal, Mode=OneWay}"/><Run Text=" AD accounts, "/>
                        <Run Text="{Binding Summary.OrphanedAdAccounts, Mode=OneWay}"/><Run Text=" orphaned"/>
                    </TextBlock>
                </Border>

                <!-- Configuration -->
                <ui:SimpleStackPanel Spacing="8" Margin="0,0,0,16">
                    <TextBlock Text="Connection" FontSize="16" FontWeight="SemiBold"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="LDAP Host:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LdapHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding LdapPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" VerticalAlignment="Center"/>

                        <CheckBox Grid.Row="0" Grid.Column="4" Content="Use LDAPS" IsChecked="{Binding UseLdaps}" VerticalAlignment="Center" Margin="0,0,24,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Search Base:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding SearchBase, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" VerticalAlignment="Center"/>

                        <ui:AppBarButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="7" Icon="Sync"
                                         Label="Test Connection"
                                         VerticalAlignment="Center"
                                         Command="{Binding TestConnectionCommand}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Authentication:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AuthTypeOptions}" SelectedItem="{Binding AuthType}" Margin="0,0,16,8" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,8,8"
                                   Visibility="{Binding AuthType, Converter={StaticResource AuthTypeToVisibilityConverter}, ConverterParameter=Simple}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" VerticalAlignment="Center"
                                 Visibility="{Binding AuthType, Converter={StaticResource AuthTypeToVisibilityConverter}, ConverterParameter=Simple}"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Password:" VerticalAlignment="Center" Margin="0,0,8,8"
                                   Visibility="{Binding AuthType, Converter={StaticResource AuthTypeToVisibilityConverter}, ConverterParameter=Simple}"/>
                        <PasswordBox Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3" Margin="0,0,16,8" VerticalAlignment="Center"
                                     Visibility="{Binding AuthType, Converter={StaticResource AuthTypeToVisibilityConverter}, ConverterParameter=Simple}"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                    </Grid>

                    <TextBlock Text="Correlation" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Vault field:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding VaultFieldOptions}" SelectedItem="{Binding VaultField}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2" Text="AD attribute:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding AdAttributeSuggestions}" Text="{Binding CorrelationAttribute, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="4" Text="Min score:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="5" Text="{Binding MinScore, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="6" Text="Max candidates:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="7" Text="{Binding MaxCandidates, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                        <ui:AppBarButton Grid.Column="9" Icon="Save" Label="Save Config" Command="{Binding SaveConfigCommand}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Match fields -->
                    <TextBlock Text="Recommendation match fields" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBlock Text="Enabled field pairs and weights drive the recommendation score. Weights are normalized automatically."
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding MatchFields}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              MaxHeight="220"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="Vault field" Binding="{Binding VaultField, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Width="160"/>
                            <DataGridTextColumn Header="AD attribute" Binding="{Binding AdAttribute, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:SimpleStackPanel>

                <!-- Results -->
                <TextBlock Text="Correlation results" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <ComboBox ItemsSource="{Binding ResultsFilterOptions}"
                          SelectedItem="{Binding ResultsFilter}"
                          Width="180"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          MinHeight="200"
                          MaxHeight="350"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Person" Binding="{Binding PersonDisplayName}" Width="220"/>
                        <DataGridTextColumn Header="External ID" Binding="{Binding ExternalId}" Width="110"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="130"/>
                        <DataGridTextColumn Header="Correlation value" Binding="{Binding CorrelationValue}" Width="130"/>
                        <DataGridTextColumn Header="AD Display Name" Binding="{Binding AdDisplayName}" Width="200"/>
                        <DataGridTextColumn Header="AD sAMAccountName" Binding="{Binding AdSamAccountName}" Width="150"/>
                        <DataGridTextColumn Header="AD UPN" Binding="{Binding AdUserPrincipalName}" Width="230"/>
                        <DataGridTextColumn Header="AD Enabled" Binding="{Binding AdEnabled}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Recommendations -->
                <TextBlock Text="Match recommendations" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <ComboBox ItemsSource="{Binding RecommendationsFilterOptions}"
                          SelectedItem="{Binding RecommendationsFilter}"
                          Width="180"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding Recommendations}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          MinHeight="150"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Actions" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Accept"
                                                Padding="8,2"
                                                Margin="4,2"
                                                Command="{Binding DataContext.AcceptRecommendationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Reject"
                                                Padding="8,2"
                                                Margin="4,2"
                                                Command="{Binding DataContext.RejectRecommendationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Score %" Binding="{Binding ScorePercent, StringFormat={}{0:0.0}}" Width="80"/>
                        <DataGridTextColumn Header="Person" Binding="{Binding PersonDisplayName}" Width="220"/>
                        <DataGridTextColumn Header="External ID" Binding="{Binding PersonExternalId}" Width="110"/>
                        <DataGridTextColumn Header="AD Display Name" Binding="{Binding AdDisplayName}" Width="220"/>
                        <DataGridTextColumn Header="AD sAMAccountName" Binding="{Binding AdSamAccountName}" Width="150"/>
                        <DataGridTextColumn Header="AD UPN" Binding="{Binding AdUserPrincipalName}" Width="230"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="16,8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
