<UserControl x:Class="HelloID.Vault.Management.Views.Administration.AdResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Panel (ReferenceDataHeader layout) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="16"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title Section -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="AD Correlation - Results" FontSize="20" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} results'}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="{Binding Summary.Matched, StringFormat=' ({0} matched)'}"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Filter -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ResultsFilterOptions}"
                          SelectedItem="{Binding ResultsFilter}"
                          Width="160"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>

                <!-- Search Box -->
                <ui:AutoSuggestBox Grid.Column="2"
                                   PlaceholderText="Search person, external ID, or AD account..."
                                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   QueryIcon="Find"
                                   VerticalAlignment="Center"
                                   MaxWidth="600"
                                   HorizontalAlignment="Center"
                                   Width="600"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:AppBarButton Label="Run Correlation"
                                     Command="{Binding RunCorrelationCommand}">
                        <ui:AppBarButton.Icon>
                            <ui:FontIcon Glyph="&#xE768;"/> <!-- Play icon -->
                        </ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Label="Write Attribute"
                                                     Command="{Binding WriteCorrelationAttributeCommand}"
                                                     ToolTip="Set the correlation attribute on matched AD accounts using each person's vault field value">
                        <ui:AppBarButton.Icon>
                            <ui:FontIcon Glyph="&#xE70F;"/> <!-- Edit icon -->
                        </ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Label="Clear Results"
                                     Command="{Binding ClearResultsCommand}"
                                     ToolTip="Delete all correlation results">
                        <ui:AppBarButton.Icon>
                            <ui:FontIcon Glyph="&#xE74D;"/> <!-- Delete icon -->
                        </ui:AppBarButton.Icon>
                    </ui:AppBarButton>
                    <ui:AppBarButton Icon="Refresh"
                                     Label="Refresh"
                                     Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid Content -->
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy">
                            <MenuItem.Icon>
                                <ui:FontIcon Glyph="&#xE8C8;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Person" Binding="{Binding PersonDisplayName}" Width="220"/>
                    <DataGridTextColumn Header="External ID" Binding="{Binding ExternalId}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="130"/>
                    <DataGridTextColumn Header="Matched Via" Binding="{Binding MatchMethod}" Width="110"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding ValueStatus}" Width="90"/>
                    <DataGridTextColumn Header="Correlation value" Binding="{Binding CorrelationValue}" Width="150"/>
                    <DataGridTextColumn Header="AD Display Name" Binding="{Binding AdDisplayName}" Width="200"/>
                    <DataGridTextColumn Header="AD sAMAccountName" Binding="{Binding AdSamAccountName}" Width="150"/>
                    <DataGridTextColumn Header="AD UPN" Binding="{Binding AdUserPrincipalName}" Width="230"/>
                    <DataGridTextColumn Header="AD Enabled" Binding="{Binding AdEnabled}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading Overlay -->
            <Border Background="#CC000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsActive="{Binding IsBusy}" Width="60" Height="60" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding ProgressText}"
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="16,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
