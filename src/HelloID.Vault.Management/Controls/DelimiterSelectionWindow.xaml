<Window x:Class="HelloID.Vault.Management.Controls.DelimiterSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Choose CSV Delimiter"
        SizeToContent="Height"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Choose the delimiter for the CSV file"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Delimiter options -->
        <StackPanel Grid.Row="1">
            <RadioButton x:Name="CommaRadio"
                         Content="Comma ( , )"
                         Margin="0,4"/>
            <RadioButton x:Name="SemicolonRadio"
                         Content="Semicolon ( ; )"
                         Margin="0,4"/>
            <RadioButton x:Name="TabRadio"
                         Content="Tab"
                         Margin="0,4"/>
        </StackPanel>

        <!-- Remember choice -->
        <CheckBox x:Name="RememberCheckBox"
                  Grid.Row="2"
                  Content="Remember this choice"
                  Margin="0,16,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Width="90"
                    Margin="0,0,8,0"/>
            <Button Content="OK"
                    Click="Ok_Click"
                    Width="90"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
